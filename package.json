{
  "name": "five-star-tap",
  "version": "1.0.0",
  "private": true,
  "description": "Marketing site + NFC review-tag territory map, on Cloudflare Workers + D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create fivestartap",
    "db:init": "wrangler d1 execute fivestartap --local --file schema.sql",
    "db:init:remote": "wrangler d1 execute fivestartap --remote --file schema.sql",
    "create-admin": "node scripts/create-admin.mjs",
    "dev:node": "node scripts/dev-node.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.1",
    "wrangler": "^4.130.0"
  },
  "allowScripts": {
    "workerd@1.20250927.0": true
  }
}
